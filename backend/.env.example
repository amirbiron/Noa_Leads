# ===== כללי =====
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Jerusalem

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/noa_leads

# ===== Auth (JWT) =====
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000

# ===== Telegram (פוש לליד חדש) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ===== Anthropic / Claude API (פאזה 3) =====
ANTHROPIC_API_KEY=

# ===== Google OAuth (פאזה 2) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ===== Gmail (intake) =====
GMAIL_PUBSUB_TOPIC=

# ===== שעות עבודה =====
WORK_DAY_START_HOUR=9
WORK_DAY_END_HOUR=18
FRIDAY_CLOSE_HOUR=16
