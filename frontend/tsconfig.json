{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // קובצי `*.test.ts` רצים ישירות תחת Node (`--experimental-strip-types`)
  // ולא נכנסים ל-build של Next. Node דורש סיומת מפורשת ב-import,
  // ו-`moduleResolution: bundler` של tsc דוחה אותה — שתי הדרישות
  // סותרות, ולכן הטסטים מוחרגים מה-typecheck של האפליקציה.
  "exclude": ["node_modules", "**/*.test.ts"]
}
